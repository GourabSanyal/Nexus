# ── Local development ─────────────────────────────────────────────────────────
# `next dev` loads .env.development (committed) + .env.local (your overrides).
# Default RUST_API_URL=http://localhost:9000 — no changes needed if wrangler runs on :9000.
#
# Optional .env.local override:
# RUST_API_URL=http://localhost:9000

# ── Vercel (set in dashboard per environment, never commit secrets) ───────────
# Production:  RUST_API_URL=https://your-worker.workers.dev
# Preview:     RUST_API_URL=https://your-worker.workers.dev  (or a staging worker)
# Development: RUST_API_URL=http://localhost:9000              (for `vercel dev` only)
#
# The browser always calls /api/rust (same-origin proxy). You do NOT need
# NEXT_PUBLIC_RUST_API_URL or CORS_ORIGIN on the worker for normal app usage.

RUST_API_URL=http://localhost:9000
