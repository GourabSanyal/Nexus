{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/*": ["../../packages/*"],
      "@components/*": ["./app/components/*"],
      "@api/*": ["../../packages/api/*"],
      "@repo/constants/*" : ["../../packages/constants/*"],
      "@api-service/solana/*": ["../../packages/api/src/services/wallet/solana/*"],
      "@api-service/ethereum/*": ["../../packages/api/src/services/wallet/ethereum/*"],
      "@api-utils/*": ["../../packages/api/src/utils/*"],
      "@api-types/*": ["../../packages/api/src/types/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
