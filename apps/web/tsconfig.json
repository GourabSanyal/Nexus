{
  "extends": "@repo/typescript-config/nextjs.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "preserve",
    "skipLibCheck": true,
    "paths": {
      "@/*": ["./*"],
      "@repo/store": ["../../packages/store/src/index.ts"],
      "@repo/zod": ["../../packages/zod/src/index.ts"],
      "@repo/constants": ["../../packages/constants/index.ts"],
      "@repo/api": ["../../packages/api/src"],
      "@repo/api/*": ["../../packages/api/src/*"],
      "@repo/*": ["../../packages/*"],
      "@components/*": ["./app/components/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "next.config.mjs",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
