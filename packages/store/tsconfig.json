{
    "compilerOptions": {
      "target": "ESNext",
      "module": "ESNext",
      "moduleResolution": "Node",
      "outDir": "dist",
      "strict": true,
      "esModuleInterop": true,
      "skipLibCheck": true,
      "forceConsistentCasingInFileNames": true,
      "declaration": true,
      "declarationMap": true,
      "emitDeclarationOnly": true,
      "baseUrl": ".",
      "paths": {
        "@/*": ["../../apps/web/app/*"],
        "@/constants/*": ["../../apps/web/app/constants/*"]
      }
    },
    "include": ["src"],
    "exclude": ["node_modules"]
  }
  