{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Node",
    "noEmit": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@repo/api": ["../api/src"],
      "@repo/api/*": ["../api/src/*"],
      "@repo/constants": ["../constants/index.ts"],
      "@repo/zod": ["../zod/src/index.ts"],
      "@repo/*": ["../*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules"]
}
