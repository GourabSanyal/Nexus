{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    "baseUrl": ".",
    "paths":{
      "@repo/*": ["../../packages/*"],
      "@store/*": ["../../packages/store/src/*"],
      "@api-types/*": ["src/types/*"],
      "@api-utils/*": ["src/utils/*"],
      "@api-configs/*": ["src/configs/*"],
      "@api-service/solana/*": ["src/services/wallet/solana/*"],
      "@api-service/ethereum/*": ["src/services/wallet/ethereum/*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist", "../../packages/store", "../../packages/store/**/*"]
}