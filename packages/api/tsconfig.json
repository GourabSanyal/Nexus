{
  "compilerOptions": {
    "target": "ES2021",
    "lib": ["ES2021"],
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": false,
    "outDir": "./dist",
    "module": "ESNext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "sourceMap": true,
    // Do not auto-include every hoisted @types package. @types/minimatch@6 is a
    // stub with no index.d.ts, and Vercel otherwise fails tsc with TS2688.
    "types": ["node"],
    "baseUrl": ".",
    "paths":{
      "@repo/constants": ["../constants/index.ts"],
      "@repo/*": ["../*"]
    }
  },
  "include": ["src"],
  "exclude": ["node_modules", "dist"]
}