{
  "name": "rust-apis",
  "version": "0.1.0",
  "description": "Rust backend for Cloudflare Workers",
  "main": "src/index.ts",
  "type": "module",
  "packageManager": "yarn@4",
  "scripts": {
    "dev": "wrangler dev",
    "build": "cargo build --target wasm32-unknown-unknown --release",
    "check": "cargo fmt --check && cargo clippy -- -D warnings && cargo test",
    "test:ts": "vitest run",
    "test:ts:watch": "vitest",
    "test:all": "yarn check && yarn test:ts",
    "preview": "wrangler dev --env production",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --env production",
    "cc": "cargo clippy --all-targets --all-features -- -W clippy::cognitive_complexity"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.14.8",
    "@cloudflare/workers-types": "^4.20240427.0",
    "@types/node": "^20.0.0",
    "vitest": "^4.1.4",
    "wrangler": "^4.77.0"
  }
}
