{
  "name": "nexus",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "test": "yarn workspace web test && yarn workspace rust-apis test:ts",
    "ci:local": "yarn test && yarn workspace web build"
  },
  "devDependencies": {
    "prettier": "^3.2.5",
    "turbo": "^2.1.1",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "yarn@4.5.3",
  "workspaces": [
    "apps/*",
    "packages/*/**"
  ],
  "dependencies": {
    "@hookform/resolvers": "^3.3.4"
  },
  "resolutions": {
    "@types/minimatch": "5.1.2"
  }
}
